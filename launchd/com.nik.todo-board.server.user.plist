<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.nik.todo-board.server.user</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/nik/projects/todo-board/scripts/start-todo.sh</string>
    <string>8000</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/nik/projects/todo-board</string>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/tmp/todo-board-server.log</string>

  <key>StandardErrorPath</key>
  <string>/tmp/todo-board-server.err.log</string>
</dict>
</plist>
